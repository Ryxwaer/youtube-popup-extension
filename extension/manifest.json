{
  "manifest_version": 3,
  "name": "Picture in Picture for YouTube – iOS-style Floating Player",
  "short_name": "PiP for YouTube",
  "version": "1.0.3",
  "description": "A floating mini player for YouTube on every tab. Drag it, pinch to resize, tuck it into the edge, just like PiP on iPhone.",
  "homepage_url": "https://github.com/Ryxwaer/youtube-popup-extension",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PiP for YouTube",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "source.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "pip.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
